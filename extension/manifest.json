{
  "manifest_version": 3,
  "name": "Meta Keyguard",
  "version": "0.1.0",
  "description": "Creates and deletes Meta Model API keys on dev.meta.ai for the Meta Keyguard CLI in WSL.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["nativeMessaging", "alarms", "storage", "scripting", "notifications"],
  "host_permissions": ["https://dev.meta.ai/*"],
  "action": { "default_popup": "popup.html", "default_title": "Meta Keyguard", "default_icon": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" } },
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" }
}
